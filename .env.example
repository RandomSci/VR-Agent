# VR Agent publishing settings. Copy to .env and fill in. NEVER commit .env.
# Everything is OFF until you turn it on. Turn one flag back to false to stop
# that feature immediately (restart start-teaching.sh after editing).

# ---- master switches ----------------------------------------------------
PUBLISHING_ENABLED=false
# true writes what would be published into data/publish-dry-run/ and only logs
# YouTube actions. Set to false only when GitHub is configured and tested.
PUBLISHING_DRY_RUN=true
# true publishes automatically when a web build passes its browser check.
# false publishes only when you type /publish in the DEV chat window.
PUBLISHING_AUTO=false

# ---- GitHub Pages (the generated-games repository, NOT VR-Agent) --------
GITHUB_PUBLISH_REPO=YourGitHubName/mika-generated-games
GITHUB_PUBLISH_BRANCH=main
# Fine-grained personal access token. Repository access is only the games repo.
# Permission is Contents, Read and write. Nothing else. SECRET.
GITHUB_PUBLISH_TOKEN=
GITHUB_PAGES_BASE_URL=https://YourGitHubName.github.io/mika-generated-games
# Password for the local gallery admin page (http://127.0.0.1:12393/vr-agent/admin.html)
PASS_W=

# ---- YouTube --------------------------------------------------------------
YOUTUBE_PUBLISHING_ENABLED=false
YOUTUBE_AUTO_CHAT_REPLY=false
YOUTUBE_AUTO_DESCRIPTION=false
YOUTUBE_AUTO_COMMENT_REPLY=false
# Leave empty. The stream that is live right now is found automatically.
# Fill only to force one video (the part after watch?v= in its URL).
YOUTUBE_VIDEO_ID=
# Your channel id (UC...). Optional, used only if the automatic lookup misses.
YOUTUBE_CHANNEL_ID=
# OAuth client from Google Cloud (Desktop app type). The secret is SECRET.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Leave empty. Run once  uv run python scripts/youtube_authorize.py
# It saves the token to data/secrets/youtube_token.json and the server keeps it
# up to date. Fill only to override that file. SECRET.
YOUTUBE_REFRESH_TOKEN=
# How many of the newest games to list in the description (1 to 10).
YOUTUBE_DESCRIPTION_LATEST=5

# ---- Optional ---------------------------------------------------------------
# Where people can watch live (the gallery's "Watch live" button).
LIVE_STREAM_URL=https://www.youtube.com/@SelwynBuilds-j1s
# A stronger model for WRITING CODE only (chat stays on conf.yaml's model).
# Empty = off. Example: gpt-5-mini (about half a US cent per game).
VR_CODE_MODEL=
# For reasoning models: minimal, low, medium or high. Lower is faster.
VR_CODE_REASONING=low

# Live chat filters: our own channel's messages are never read (VR_IGNORE_OWNER=0 to allow).
# Extra names to ignore completely, comma separated, e.g. @SelwynBuilds-j1s
VR_BANNED_AUTHORS=
VR_IGNORE_OWNER=1
# Gallery link in chat now and then, only when enough people are chatting.
VR_GALLERY_PROMO=1
VR_PROMO_MIN_VIEWERS=3
VR_PROMO_EVERY_MINUTES=20

# Class mode: Mika teaches a real course (slides + a live notebook), even with
# zero viewers. Chat questions are answered between steps, quizzes by A/B/C.
# 1 = class mode, 0 = the build-anything mode.
VR_CLASS_MODE=0
# python-basics, math-with-python or data-basics (it continues where it stopped)
VR_CLASS_COURSE=python-basics
VR_CLASS_TEACHER=mika
VR_CLASS_QUIZ_SECONDS=20

# Minecraft mode: ./go-live.sh --minecraft (run ./minecraft/setup.sh once first).
# Mika and Luna play survival Minecraft by themselves, chat tells them what to do.
# The bots' brain (uses OPENAI_API_KEY above)
VR_MINECRAFT_MODEL=gpt-4o-mini
VR_MINECRAFT_RAM=2G
# Seconds between AI calls per bot. 10 is about 4 USD per 12 hours on
# gpt-4o-mini; lower is livelier and costs more.
VR_MINECRAFT_THINK_SECONDS=10
# Each Minecraft stream gets assets/thumbnails/minecraft.jpg as its thumbnail
# (0 = leave the thumbnail alone)
YOUTUBE_AUTO_THUMBNAIL=1
# Each show has its own playlist (made the first time), every live is added
YOUTUBE_AUTO_PLAYLIST=1
# OBS is set to this before every stream (30 fps is half the work of 60)
VR_OBS_FPS=30
VR_OBS_BITRATE=6000
# VR_MINECRAFT_GOAL=Build the biggest castle in the world

# The stream runs itself (needs the YouTube sign-in)
# Each lesson renames the live stream and rewrites its description.
YOUTUBE_AUTO_TITLE=1
# The channel About text is set at start (see publishing/stream_autopilot.py).
YOUTUBE_AUTO_CHANNEL_DESCRIPTION=1
# Say goodbye and end the stream after this many minutes live (0 = never).
VR_MAX_LIVE_MINUTES=715
# OBS: go-live.sh starts it minimized and streaming; the limit stops it.
VR_START_OBS=0
OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=
